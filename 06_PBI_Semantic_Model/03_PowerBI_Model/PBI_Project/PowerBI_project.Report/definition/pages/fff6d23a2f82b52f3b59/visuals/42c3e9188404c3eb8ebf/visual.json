            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Mortality metrics indicate outcome risk exposure, not effectiveness or performance. Reference points are contextual anchors, not targets. Differences reflect variation in exposure rather than categorical classification.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This view does not establish causality, assess quality or management, or imply correctable success or failure. ",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Mortality should be used as a baseline outcome lens when interpreting discharge patterns, exit constraints, or payer mix exposure, with facilities of similar exposure treated as contextual comparators. ",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The domain frames outcome risk context only and is not an explanatory or evaluative endpoint.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              }
            ]
          }
        }
