            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Financial stress pressure",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " reflects the system’s ability to "
                  },
                  {
                    "value": "convert clinical activity into sustainable margin",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " after admission."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Unlike payer mix or baseline cost structure (who pays and at what rate), financial stress pressure captures "
                  },
                  {
                    "value": "how efficiently costs are controlled relative to volume and throughput",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "It is most commonly driven by:"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "excess length of stay and avoidable bed-days"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "high cost per encounter without acuity justification"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "throughput inefficiencies that compound fixed costs"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "When sustained, excess margin pressure "
                  },
                  {
                    "value": "concentrates financial risk",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", erodes operating flexibility, and amplifies the impact of already tight reimbursement environments."
                  }
                ]
              }
            ]
