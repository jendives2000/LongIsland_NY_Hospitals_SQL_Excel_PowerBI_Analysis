          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "As the most consequential downstream outcome, mortality provides essential context for interpreting subsequent operational and financial patterns. ",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Given established upstream conditions, mortality variation helps distinguish system-wide outcome risk from localized concentration and separates baseline risk context from downstream disposition and reimbursement dynamics. ",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Without this context, later variation may be misattributed to operational or financial factors alone.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
