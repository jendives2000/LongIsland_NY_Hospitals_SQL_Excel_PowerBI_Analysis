  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "This page evaluates whether observed differences in "
                  },
                  {
                    "value": "length of stay (LOS)",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " reflect "
                  },
                  {
                    "value": "baseline patient complexity",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", "
                  },
                  {
                    "value": "intake-driven congestion",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", or "
                  },
                  {
                    "value": "true internal throughput constraints",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Severity analysis shows that patient acuity is "
                  },
                  {
                    "value": "tightly clustered within peer groups",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", and intake analysis confirms that "
                  },
                  {
                    "value": "high unplanned demand is the dominant operating condition",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " across the network."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Under these conditions, persistent LOS variation is "
                  },
                  {
                    "value": "unlikely to be explained by case mix or random demand alone",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The focus of this page is therefore on identifying "
                  },
                  {
                    "value": "where prolonged stays signal flow breakdowns inside the hospital",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", rather than structural inevitability."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
