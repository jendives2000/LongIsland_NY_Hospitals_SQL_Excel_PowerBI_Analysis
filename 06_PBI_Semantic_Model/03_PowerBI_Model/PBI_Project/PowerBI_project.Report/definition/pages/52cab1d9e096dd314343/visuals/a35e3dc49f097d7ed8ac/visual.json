    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "LOS should be interpreted ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "within peer-group context",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": ", not against system-wide averages",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Observed variation describes ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "flow conditions",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": ", not care quality or operational effectiveness",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Similar LOS across peer groups is consistent with shared structural constraints, while dispersion is consistent with differing internal flow conditions.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Patterns shown here are ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "descriptive and contextual",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": " and do not establish causality",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This page establishes a ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "throughput baseline",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": " that frames how subsequent metrics should be read, not a conclusion about why differences occur or how they should be addressed.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              }
            ]
          }
        }
