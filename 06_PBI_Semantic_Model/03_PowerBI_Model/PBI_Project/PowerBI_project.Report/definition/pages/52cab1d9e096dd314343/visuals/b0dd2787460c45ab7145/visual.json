    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Throughput pressure describes operational strain that arises "
                  },
                  {
                    "value": "after admission",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", when patients remain hospitalized longer than expected relative to peers facing similar acuity and intake conditions."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Unlike severity (who we treat) or intake pressure (how patients arrive), throughput pressure reflects "
                  },
                  {
                    "value": "how efficiently the system converts admissions into timely discharges",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "It is most commonly driven by:"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "delays in diagnostics, consults, or procedures",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "unit-level bed turnover and internal transfers",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "discharge planning friction and post-acute placement constraints",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "When sustained, excess LOS reduces effective bed capacity, compounds congestion created by unplanned intake, and increases cost per encounter without improving outcomes."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
