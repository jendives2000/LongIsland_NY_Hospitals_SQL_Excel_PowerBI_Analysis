                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "When payer mix is similar within peer groups, downstream financial and outcome variation is ",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": "unlikely to be driven by reimbursement differences alone",
