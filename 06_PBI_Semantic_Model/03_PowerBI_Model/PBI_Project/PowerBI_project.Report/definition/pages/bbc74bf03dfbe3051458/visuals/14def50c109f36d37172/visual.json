  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "INSIGHT:",
                    "textStyle": {
                      "fontSize": "11pt",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "horizontalTextAlignment": "center"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This view establishes intake context that should be carried forward when interpreting throughput, cost, and outcome variation.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Unplanned admission share is elevated across all peer groups (≈65%–86%), indicating that ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "unplanned intake is a system-wide operating condition",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": ", not one confined to a specific segment. While levels vary by peer group, overall intake remains high across the network, consistent with emergency and urgent pathways serving as primary admission routes.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "INTERPRETATION GUIDANCE: ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "textDecoration": "underline"
                    }
                  }
                ],
                "horizontalTextAlignment": "center"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Read this view as ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "context, not performance evaluation",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": ".",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Because unplanned intake is high across peer groups, downstream metrics (e.g., LOS, cost, throughput) should be interpreted with ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "intake pressure as a common baseline",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": ", rather than assuming a low-intake operating state. Differences across peer groups provide ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "contextual segmentation",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": ", not causal explanation or evidence of operational effectiveness.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              }
            ]
          }
        }
      ],
