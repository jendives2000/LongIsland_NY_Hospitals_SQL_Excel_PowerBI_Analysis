  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Why unplanned intake changes how performance should be interpreted"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Intake pressure describes the "
                  },
                  {
                    "value": "operational strain",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " created when a "
                  },
                  {
                    "value": "large share of inpatient admissions arrive unplanned",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", primarily through emergency and urgent pathways."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Unlike scheduled admissions, unplanned intake is "
                  },
                  {
                    "value": "unpredictable, time-compressed, and difficult to smooth",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", requiring facilities to "
                  },
                  {
                    "value": "absorb demand immediately",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " rather than redistribute it over time."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "When elevated unplanned admissions coincide with sustained encounter volume, pressure propagates across the system",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "—affecting emergency department congestion, bed availability, staffing stability, and patient flow."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Under these conditions, variation in downstream metrics such as length of stay and cost is less likely to reflect random demand fluctuation and "
                  },
                  {
                    "value": "more likely to reflect differences in intake management, flow control, and discharge effectiveness.",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
