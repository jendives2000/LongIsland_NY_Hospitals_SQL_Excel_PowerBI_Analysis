                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Under these conditions, variation in downstream metrics such as LOS and cost is ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "less likely to reflect random demand fluctuation",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": " and more likely to reflect structural flow constraints.",
                    "textStyle": {
