  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "INSIGHT:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " ",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Unplanned admission rates remain elevated across all peer groups, ranging from "
                  },
                  {
                    "value": "{Min Unplanned Rate}% to {Max Unplanned Rate}%",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", with a peer-group median of "
                  },
                  {
                    "value": "{Median Unplanned Rate}%",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "{Facilities Above Median} of {Total Facilities}",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " facilities operate above their peer-group unplanned intake median, indicating broad, system-wide intake pressure rather than isolated outliers."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "When intake pressure is examined alongside volume, only "
                  },
                  {
                    "value": "{Facilities In Low-Pressure Zone} facilities",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " fall below both "
                  },
                  {
                    "value": "{UA Threshold}% unplanned admissions",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " and "
                  },
                  {
                    "value": "{Volume Threshold} encounters",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", while the majority operate above both thresholds."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This confirms that high unplanned intake is the dominant operating mode across the network."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "IMPACT:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " ",
                    "textStyle": {
                      "textDecoration": "underline"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Because elevated unplanned admission rates coincide with "
                  },
                  {
                    "value": "material inpatient volume",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", intake pressure is not a marginal effect."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "For most facilities, this combination amplifies:"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "ED congestion"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Bed turnover stress"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Staffing and throughput volatility"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "This reduces the likelihood that downstream LOS, cost, or quality variation can be attributed to random demand fluctuation."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Instead, observed performance differences are more likely driven by "
                  },
                  {
                    "value": "intake management, flow control, and discharge effectiveness",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "ACTION:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " "
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use this intake pressure baseline to:"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Normalize LOS and cost comparisons in the context of sustained unplanned demand"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Prioritize flow and bed-management deep dives at facilities operating above both rate and volume thresholds"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Treat facilities within the low-pressure zone as "
                  },
                  {
                    "value": "structural comparators",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", not performance benchmarks"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Focus operational interventions on intake smoothing, ED diversion, and discharge velocity rather than acuity adjustment"
                  }
                ],
                "listType": "bullet"
              }
            ]
          }
        }
      ],
