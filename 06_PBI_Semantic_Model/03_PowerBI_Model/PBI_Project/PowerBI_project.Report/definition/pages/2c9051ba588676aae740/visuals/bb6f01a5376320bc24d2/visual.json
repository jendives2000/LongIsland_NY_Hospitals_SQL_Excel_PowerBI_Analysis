  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Earlier pages showed that:"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Patient severity is tightly clustered within peer groups",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", limiting case-mix as a primary explanation for performance differences."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Unplanned intake pressure is system-wide",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", affecting all facilities rather than a small subset."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Throughput pressure (LOS)",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " varies meaningfully within peer groups and is "
                  },
                  {
                    "value": "concentrated in a limited number of high-volume facilities",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", driving disproportionate bed-day burden."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "With these clinical and operational pressures established, this page shifts focus to "
                  },
                  {
                    "value": "financial outcomes",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The goal of this page is to assess whether observed "
                  },
                  {
                    "value": "cost and margin pressure",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " reflects:"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "structural financial conditions",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " such as payer mix and baseline cost structure, or"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "operational effects",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", where throughput inefficiency and excess LOS translate into higher cost per encounter."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This page also evaluates whether financial stress is "
                  },
                  {
                    "value": "broadly distributed",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " across the system or "
                  },
                  {
                    "value": "concentrated in a small number of high-impact facilities",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", consistent with the concentration patterns observed for bed-days."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
