            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Financial stress pressure describes the ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "operating strain observed  when the cost of delivering inpatient care persistently approaches or exceeds realized reimbursement",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": " under prevailing demand conditions.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "It reflects the combined presence of medical cost per encounter, reimbursement dynamics, payer mix, and sustained inpatient volume. Unlike short-term margin fluctuation driven by isolated cases or timing effects, financial stress pressure captures ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "systemic exposure",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": " that is associated with reduced operational flexibility.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
