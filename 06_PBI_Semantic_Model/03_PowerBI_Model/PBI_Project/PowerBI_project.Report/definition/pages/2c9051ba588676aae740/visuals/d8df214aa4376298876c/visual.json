        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Sustained financial stress is associated with reduced tolerance for variability in demand, staffing, and patient flow. Under elevated pressure:",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Throughput delays more often coincide with higher cost exposure",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "High-cost encounters account for a larger share of total margin risk",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Operational disruptions cluster rather than occurring in isolation",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Accordingly, downstream variation in LOS, bed-days, or throughput drag should be interpreted in the context of underlying financial pressure, not assumed to reflect localized inefficiency.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
