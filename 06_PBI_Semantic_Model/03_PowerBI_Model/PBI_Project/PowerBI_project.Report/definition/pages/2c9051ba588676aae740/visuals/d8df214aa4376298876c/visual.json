          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Sustained financial stress reduces a system’s ability to absorb variability in demand, staffing, or patient flow.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Under elevated margin pressure:",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Delays in throughput translate more directly into cost escalation",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "High-cost encounters exert disproportionate impact on aggregate margins",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Operational disruptions are more likely to compound rather than dissipate",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "As a result, variation in downstream measures such as length of stay, bed-days, or throughput drag should be interpreted in the context of underlying financial pressure rather than assumed to reflect isolated inefficiencies.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
