        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Sustained financial stress is associated with lower system tolerance for variability in demand, staffing, or patient flow.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "In contexts where elevated margin pressure is observed::",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Delays in throughput are more frequently observed alongside higher cost exposure",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "High-cost encounters represent a larger share of aggregate margin exposure",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Operational disruptions tend to co-occur with sustained pressure rather than appearing as isolated events",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Accordingly, variation in downstream measures such as length of stay, bed-days, or throughput drag should be interpreted in the context of underlying financial pressure rather than assumed to reflect isolated inefficiencies.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              }
            ]
          }
        }
