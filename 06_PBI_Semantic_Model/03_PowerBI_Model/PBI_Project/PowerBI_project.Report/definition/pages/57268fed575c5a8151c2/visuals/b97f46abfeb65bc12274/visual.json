  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "I",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": "NSIGHT:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This view highlights "
                  },
                  {
                    "value": "within–peer-group severity positioning",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", showing facilities whose Severity Mix Index (SMI) sits "
                  },
                  {
                    "value": "above their own peer-group median",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", rather than above a system-wide benchmark."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Facilities above their peer median are present across multiple peer groups, with "
                  },
                  {
                    "value": "PG-B (Large Community)",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " and "
                  },
                  {
                    "value": "PG-C (Mid-Size Community)",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " containing the greatest number of such facilities. This indicates that "
                  },
                  {
                    "value": "relative severity positioning varies within peer groups",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", even where overall group medians differ."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "These patterns reflect "
                  },
                  {
                    "value": "distribution within peer context",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", not absolute severity dominance across the system."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "INTERPRETATION GUIDANCE:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Being above a "
                  },
                  {
                    "value": "peer-group median",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " indicates "
                  },
                  {
                    "value": "relative positioning within a similar operating and patient-mix context",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", not higher acuity compared to other peer groups."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "This view is most useful for understanding "
                  },
                  {
                    "value": "intra-group dispersion",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", rather than cross-group comparison."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Facilities above their peer median should be interpreted as operating on the "
                  },
                  {
                    "value": "upper end of expected severity for that peer type",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", not as outliers or exceptions."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Differences observed here describe "
                  },
                  {
                    "value": "variation in case-mix composition within structurally similar settings",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", not performance differences or care quality."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Use this view to "
                  },
                  {
                    "value": "refine contextual interpretation",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " of downstream metrics (LOS, cost, mortality) by anchoring analysis to "
                  },
                  {
                    "value": "peer-relative baselines",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", rather than system averages."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "This view provides "
                  },
                  {
                    "value": "contextual positioning",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", not evaluation, and does not establish causality or performance attribution."
                  },
                  {
                    "value": "subsequent pages, not as an explanatory endpoint.",
                    "textStyle": {
                      "fontSize": "10.5pt"
                    }
                  }
                ],
                "listType": "bullet"
              }
            ]
          }
        }
      ],
