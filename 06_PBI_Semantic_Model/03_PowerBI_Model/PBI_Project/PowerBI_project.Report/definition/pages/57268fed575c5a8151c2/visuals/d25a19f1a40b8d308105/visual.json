                  },
                  {
                    "value": "largely independent of day-to-day operational processes",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": " and is ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "shaped by broader system-level factors",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": ".",
                    "textStyle": {
                      "fontSize": "11pt"
