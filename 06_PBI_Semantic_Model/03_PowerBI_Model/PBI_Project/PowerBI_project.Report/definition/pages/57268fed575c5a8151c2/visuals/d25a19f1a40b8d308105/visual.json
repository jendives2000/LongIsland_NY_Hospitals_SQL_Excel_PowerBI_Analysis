            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Severity reflects underlying clinical complexity",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": " that is ",
                    "textStyle": {
                      "fontSize": "11pt"
