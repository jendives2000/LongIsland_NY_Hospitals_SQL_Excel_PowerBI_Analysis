  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "I",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": "NSIGHT:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This view shows the "
                  },
                  {
                    "value": "distribution of patient acuity categories (Minor, Moderate, Major, Extreme)",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " across facilities, establishing "
                  },
                  {
                    "value": "baseline severity composition",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " rather than overall acuity level."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Across the system, facilities display "
                  },
                  {
                    "value": "similar overall Severity Mix Index (SMI) ranges",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", but "
                  },
                  {
                    "value": "acuity composition varies meaningfully",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", particularly in the share of "
                  },
                  {
                    "value": "Extreme severity cases",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ". This indicates that while baseline complexity is broadly comparable, "
                  },
                  {
                    "value": "case-mix structure differs across facilities and peer contexts",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The variation observed reflects "
                  },
                  {
                    "value": "distributional differences in patient acuity mix",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", not uniform shifts in severity across the system."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "INTERPRETATION GUIDANCE:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This visual is intended to "
                  },
                  {
                    "value": "establish acuity context before interpreting downstream performance metrics",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", such as length of stay, cost, or mortality."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Differences in the "
                  },
                  {
                    "value": "share of Extreme, Major, Moderate, or Minor cases",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " describe "
                  },
                  {
                    "value": "case-mix composition",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", not overall severity dominance or operational effectiveness."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Facilities with a higher Extreme share are operating within a "
                  },
                  {
                    "value": "different acuity profile",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", even if their total SMI remains near peer norms."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Observed variation should be interpreted as "
                  },
                  {
                    "value": "contextual input",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " for subsequent analyses, not as evidence of efficiency, quality, or performance differences."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Use this view to "
                  },
                  {
                    "value": "anchor interpretation",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " of later pages by distinguishing "
                  },
                  {
                    "value": "case-mix structure effects",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " from operational or throughput drivers."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Patterns shown are descriptive, reflect acuity mix distribution, and do not establish causality or performance attribution."
                  }
                ]
              }
            ]
          }
        }
      ],
