  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "I",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": "NSIGHT:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This view isolates facilities whose "
                  },
                  {
                    "value": "Severity Mix Index (SMI) exceeds the cross-peer-group median (2.78)",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " Even within this subset, SMI values remain "
                  },
                  {
                    "value": "tightly clustered",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", indicating that differences above the median reflect "
                  },
                  {
                    "value": "modest variation in baseline acuity",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", not extreme divergence."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The presence of multiple facilities across different peer groups above the network median suggests that "
                  },
                  {
                    "value": "elevated baseline severity is distributed",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", rather than concentrated in a single facility type or segment."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " This reinforces that patient acuity differences, while present, remain "
                  },
                  {
                    "value": "bounded within a relatively narrow range",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "INTERPRETATION GUIDANCE:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This filtered view should be read as a "
                  },
                  {
                    "value": "contextual lens",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", not a performance distinction."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Because SMI values above the network median remain closely grouped:"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Differences observed in downstream metrics (e.g., length of stay, cost, mortality, throughput) "
                  },
                  {
                    "value": "are unlikely to be driven by case-mix severity alone",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Facilities above the median should not be interpreted as operating under uniquely extreme acuity conditions"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Use this view to:"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Confirm that "
                  },
                  {
                    "value": "baseline severity has been accounted for",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Establish a "
                  },
                  {
                    "value": "severity-adjusted comparison frame",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " for subsequent pages"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Severity context provides "
                  },
                  {
                    "value": "orientation",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", not explanation, and should inform interpretation of later metrics rather than serve as an endpoint."
                  }
                ],
                "listType": "bullet"
              }
            ]
          }
        }
      ],
