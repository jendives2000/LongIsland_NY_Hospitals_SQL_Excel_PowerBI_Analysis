/// Financial analysis measure container. Contains measures for margin pressure analysis, cost-per-encounter metrics, negative margin rates, peer group financial benchmarking, and Pareto analysis of margin burden across facilities.
table _Financial_Basic
	lineageTag: 9abe8882-ef5b-477d-a3c5-eabaf7b09d85

	/// Sum of costs.
	measure 'Total Costs' = SUM(Fact_KPI_FinancialPressure[Total_Costs])
		displayFolder: Base
		lineageTag: 46929712-57b8-435d-ac1f-49bc5893fb1e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sum of charges.
	measure 'Total Charges' = SUM(Fact_KPI_FinancialPressure[Total_Charges])
		displayFolder: Base
		lineageTag: c08d873e-819b-4cef-9527-b8d9de87ff22

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Alias for FP Margin. Total charges minus total costs.
	measure 'Total Margin' = [FP Margin]
		displayFolder: Base
		lineageTag: 219223b6-bf98-4a47-a2ce-38ec07807251

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average costs per encounter.
	measure 'AVG Cost / Encounter' =
			
			DIVIDE(
			    SUM(Fact_KPI_FinancialPressure[Total_Costs]),
			    SUM(Fact_KPI_FinancialPressure[Encounter_Count])
			)
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: Base
		lineageTag: a59e7ed7-5288-4dc0-809a-ceb0c24daca7

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Average charges per encounter.
	measure 'AVG Charge / Encounter' =
			
			DIVIDE(
			    SUM(Fact_KPI_FinancialPressure[Total_Charges]),
			    SUM(Fact_KPI_FinancialPressure[Encounter_Count])
			)
		displayFolder: Base
		lineageTag: f1ef9784-bb46-46cf-9b54-7707921734bb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average margin (charges minus costs) per encounter.
	measure 'AVG Margin / Encounter' =
			
			DIVIDE(
			    [Total Margin],
			    SUM(Fact_KPI_FinancialPressure[Encounter_Count])
			)
		displayFolder: Base
		lineageTag: f95deb85-1fdb-4bd9-8fdf-96163dc2eb8b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Count of encounters where costs exceeded charges.
	measure 'Neg Margin Total Encounters' = SUM(Fact_KPI_FinancialPressure[Negative_Margin_Encounter_Count])
		formatString: 0
		displayFolder: Base
		lineageTag: 5aa6b431-9348-41c5-8f75-add6f1f9ebba

	/// Share of encounters with negative margin (costs exceed charges).
	measure 'Neg Margin Rate' =
			
			DIVIDE(
			    [Neg Margin Total Encounters],
			    SUM(Fact_KPI_FinancialPressure[Encounter_Count])
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Base
		lineageTag: 5a3a15b3-1591-45d1-9632-c2d3e0beb332

	/// Cost-to-charge ratio weighted by encounter volume. Higher values indicate both poor margins and high volume—priority targets for intervention.
	measure 'Margin Pressure Burden' =
			
			[Margin Pressure] * SUM(Fact_KPI_FinancialPressure[Encounter_Count])
		displayFolder: Helper
		lineageTag: e8e2ec27-8019-4ca9-bb1c-51a63ba22c9e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Median cost-to-charge ratio across all facilities. Ignores peer group assignment.
	measure 'Cross-PG Margin Pressure Median' =
			
			CALCULATE(
			    MEDIANX(
			        VALUES(Dim_Facility[Facility_Key]),
			        [Margin Pressure]
			    ),
			    REMOVEFILTERS(Dim_Facility)
			)
		displayFolder: Helper
		lineageTag: 5f283d86-0e4d-4d90-80e9-bd8c21e44a0b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Facility cost-to-charge ratio minus peer group median. Positive = worse financial position than peers.
	measure 'Excess Margin Pressure vs PG Median' =
			
			[Margin Pressure] - [PeerGroup Margin Pressure Median]
		displayFolder: Helper
		lineageTag: 96b446e1-f4a9-4003-a8d8-f6da3f0f568a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Flag (1/0) if facility cost-to-charge ratio exceeds peer group median.
	measure 'Is Above PG Margin Median' =
			
			VAR Excess = [Excess Margin Pressure vs PG Median]
			RETURN
			IF(Excess > 0, 1, 0)
		formatString: 0
		displayFolder: Helper
		lineageTag: 933af802-bc9b-4dad-9de6-4a0dea35cdb7

	/// Flag (TRUE/FALSE) if facility cost-to-charge ratio exceeds system-wide median.
	measure 'Is Above Cross-PG Margin Median' =
			
			VAR CurrentMP = [Margin Pressure]
			VAR CrossMedian = [Cross-PG Margin Pressure Median]
			RETURN
			IF(CurrentMP > CrossMedian, TRUE(), FALSE())
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: Helper
		lineageTag: 4ca6b3d2-f9f0-489d-af10-559e5f8cf05d

	/// Count of facilities with any negative-margin encounters.
	measure 'Facilities with Negative Margin' =
			
			CALCULATE(
			    DISTINCTCOUNT(Fact_KPI_FinancialPressure[Facility_Key]),
			    FILTER(
			        VALUES(Fact_KPI_FinancialPressure[Facility_Key]),
			        [Neg Margin Rate] > 0
			    )
			)
		formatString: 0
		displayFolder: Helper
		lineageTag: b9f84d05-479c-4b79-b00a-f840ca92fc2e

	/// Running share of total margin burden for Pareto analysis. Facilities ranked by margin burden descending; shows cumulative percentage at each facility. Returns blank if facility has no margin burden.
	measure 'Cumulative Margin Burden %' = ```
			
			VAR Cohort =
			    ADDCOLUMNS (
			        ALLSELECTED ( Dim_Facility[Facility_Name]),
			        "__B", CALCULATE ( [Margin Pressure Burden] )
			    )
			VAR CohortNZ =
			    FILTER ( Cohort, NOT ISBLANK ( [__B] ) )
			VAR CurrentB =
			    CALCULATE ( [Margin Pressure Burden] )
			VAR RunningB =
			    SUMX ( FILTER ( CohortNZ, [__B] >= CurrentB ), [__B] )
			VAR TotalB =
			    SUMX ( CohortNZ, [__B] )
			RETURN
			    IF ( ISBLANK ( CurrentB ) || TotalB <= 0, BLANK (), DIVIDE ( RunningB, TotalB ) )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Helper
		lineageTag: 2cffff85-b832-4500-8f88-6338855e0483

	/// Volume guardrail flag. Returns 1 if encounters ≥ 30, else 0. Used to suppress unreliable rates from small samples.
	measure 'Financial Has Volume' =
			
			IF(
			    SUM(Fact_KPI_FinancialPressure[Encounter_Count]) >= 30,
			    1,
			    0
			)
		formatString: 0
		displayFolder: Helper
		lineageTag: 469913f9-2613-4e1e-bf3b-e11c17b80229

	/// Count of facilities with cost-to-charge ratio above their peer group median.
	measure 'Facilities Above PG Median' =
			
			CALCULATE(
			    DISTINCTCOUNT(Dim_Facility[Facility_Key]),
			    FILTER(
			        VALUES(Dim_Facility[Facility_Key]),
			        [Is Above PG Margin Median] = TRUE()
			    )
			)
		formatString: 0
		displayFolder: Helper
		lineageTag: 5a3e057f-8324-44b9-8287-e102ffd4539d

	/// Alias for AVG Charge / Encounter.
	measure 'Avg Charges per Encounter' = [AVG Charge / Encounter]
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: Base
		lineageTag: 72384724-e34a-4b2e-a20b-db528c447066

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Count of facilities with cost-to-charge ratio above the system-wide median.
	measure 'Facilities Above Cross-PG Median' =
			
			CALCULATE(
			    DISTINCTCOUNT(Dim_Facility[Facility_Key]),
			    FILTER(
			        VALUES(Dim_Facility[Facility_Key]),
			        [Is Above Cross-PG Margin Median] = TRUE()
			    )
			)
		formatString: 0
		displayFolder: Helper
		lineageTag: 5125b51d-bdf8-4234-9bd0-3be9cb64af62

	/// Count of facilities in current filter context.
	measure 'Total Fin Facilities' =
			
			DISTINCTCOUNT(Dim_Facility[Facility_Key])
		formatString: 0
		displayFolder: Helper
		lineageTag: 4abbf1d6-7b2b-4b3b-9220-6c0ede6a6b89

	/// Flag (1/0) if facility cost-to-charge ratio exceeds its own peer group median. Uses guarded margin pressure (returns 0 if volume < 30).
	measure 'Is Above Own PG Margin Median' = ```
			
			VAR FacilityMargin =
			    [Margin Pressure (Guarded)]
			VAR PGMedian =
			    [PeerGroup Margin Pressure Median]
			RETURN
			IF (
			    NOT ISBLANK ( FacilityMargin )
			        && FacilityMargin > PGMedian,
			    1,
			    0
			)
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: b1811f68-ad78-40b0-95ac-ba434205034a

	/// Median cost-to-charge ratio across all facilities system-wide. Ignores peer group assignment and current facility filter.
	measure 'All-Facilities Margin Pressure Median' = ```
			
			CALCULATE (
			    VAR T =
			        ADDCOLUMNS (
			            ALL ( Dim_Facility[Facility_Key] ),
			            "__mp", CALCULATE ( [Margin Pressure] )
			        )
			    RETURN
			        MEDIANX ( FILTER ( T, NOT ISBLANK ( [__mp] ) ), [__mp] ),
			    REMOVEFILTERS ( Dim_Facility )
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Helper
		lineageTag: f91af44f-6756-45a9-9225-501dfed5dd3f

	/// Median cost-to-charge ratio across facilities in selected peer group. Requires single peer group in filter context; otherwise returns blank.
	measure 'PeerGroup Margin Pressure Median' =
			
			VAR CurrentPG = SELECTEDVALUE(Dim_Facility[PeerGroup_Name])
			RETURN
			IF(
			    NOT ISBLANK(CurrentPG),
			    CALCULATE(
			        MEDIANX(
			            VALUES(Dim_Facility[Facility_Key]),
			            [Margin Pressure]
			        ),
			        REMOVEFILTERS(Dim_Facility[Facility_Key]),
			        REMOVEFILTERS(Dim_Facility[Facility_Name]),
			        Dim_Facility[PeerGroup_Name] = CurrentPG
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: PeerGroup Benchmarks
		lineageTag: a25f0900-a780-4fb7-8694-8d7f830c1600

	column Column
		formatString: 0
		lineageTag: 1634b4fb-d72b-41c8-929c-7587a2038b92
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _Financial_Basic = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 945356379fdc4c649295c5c5aba5aa8a

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

