/// Patient acuity analysis measure container. Contains measures for severity mix index, extreme severity percentages, peer group severity benchmarking, and facility comparison flags. Supports contextual interpretation of case-mix complexity.
table _Severity
	lineageTag: 1a92feb6-85fb-43a8-88bb-9033582841e1

	/// Share of encounters for selected severity level.
	measure 'Severity Encounter %' = ```
			
			VAR Num =
			    SUM ( vw_Fact_KPI_SeverityMix_BySeverity[Encounter_Count] )
			VAR Den =
			    CALCULATE (
			        SUM ( vw_Fact_KPI_SeverityMix_BySeverity[Encounter_Count] ),
			        REMOVEFILTERS ( Dim_ClinicalClass )
			    )
			RETURN
			    DIVIDE ( Num, Den )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0d681068-6f35-4ab5-9770-fa46e04f9580

	/// Share of encounters with Extreme APR severity. Indicates high-acuity case mix.
	measure 'Extreme Severity %' = ```
			
			DIVIDE(
			    [Extreme Encounters],
			    CALCULATE( [Total Encounters], REMOVEFILTERS( Dim_ClinicalClass ) )
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Extreme Level
		lineageTag: dbaec5fa-2515-403e-9623-85858aa1e8eb

	/// Median extreme severity % within the selected peer group. Requires peer group in filter context.
	measure 'Peer Group Median Extreme %' = ```
			
			VAR CurrentPG = SELECTEDVALUE( Dim_PeerGroup[PeerGroup_Name] )
			RETURN
			CALCULATE(
			    MEDIANX(
			        VALUES( Dim_Facility[Facility_Key] ),
			        [Extreme Severity %]
			    ),
			    REMOVEFILTERS( Dim_ClinicalClass ),
			    ALL( Dim_Facility ),
			    Dim_PeerGroup[PeerGroup_Name] = CurrentPG
			)
			
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Extreme Level
		lineageTag: d3fa44b6-8a8b-4836-bcce-a65f036d0628

	/// Facility extreme severity % minus peer group median. Positive = higher acuity than peers.
	measure 'Extreme % vs Peer Median' = ```
			
			[Extreme Severity %] - [Peer Group Median Extreme %]
			
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Extreme Level
		lineageTag: 80582048-dbc5-43b6-8fd4-bdc28ed246e0

	/// Text flag: 'Above Peer Median' or 'At or Below Peer Median' for extreme severity share.
	measure 'Extreme Above Peer Median Flag' = ```
			
			IF(
			    [Extreme % vs Peer Median] > 0,
			    "Above Peer Median",
			    "At or Below Peer Median"
			)
			
			```
		displayFolder: Extreme Level
		lineageTag: 2bf14f6e-d8c2-4bcf-81f3-c1b1b8ce6320

	/// Total encounters from severity mix by severity view.
	measure 'Total Encounters' = ```
			
			SUM ( vw_Fact_KPI_SeverityMix_BySeverity[Encounter_Count] )
			
			```
		formatString: 0
		lineageTag: 660a6176-8cc0-4625-b07c-f87f826105ca

	/// Count of encounters with Extreme APR severity level.
	measure 'Extreme Encounters' = ```
			
			CALCULATE(
			    [Total Encounters],
			    REMOVEFILTERS( Dim_ClinicalClass ),
			    Dim_ClinicalClass[APR_Severity_Description] = "Extreme"
			)
			
			```
		formatString: 0
		displayFolder: Extreme Level
		lineageTag: 485287fa-08f6-403b-bd67-d60b0c325242

	/// Median extreme severity % across all facilities. Ignores current facility and peer group filters.
	measure 'Median Extreme % (Selected)' = ```
			
			CALCULATE(
			    MEDIANX(
			        ALL( Dim_Facility[Facility_Key] ),
			        [Extreme Severity %]
			    ),
			    REMOVEFILTERS( Dim_ClinicalClass ),
			    REMOVEFILTERS( Dim_Facility )
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Extreme Level
		lineageTag: 64aead1c-c363-4697-9c75-c3866cd56851

	/// Conditional formatting: dark gray if above median, neutral gray otherwise.
	measure 'Extreme vs Median Bar Color' = ```
			
			IF(
			    [Extreme Severity %] > [Median Extreme % (Selected)],
			    "#3A3A3A",   -- dark grey
			    "#6E6E6E"    -- neutral gray
			)
			
			```
		displayFolder: Helper
		lineageTag: 6a350604-ebc6-4f66-941d-ceb6b53edad0

	/// Flag (1/0) if facility extreme severity % exceeds selected median.
	measure 'Is Above Median Extreme' = ```
			
			IF( [Extreme Severity %] > [Median Extreme % (Selected)], 1, 0 )
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: 2a7222a2-67a0-4e23-8b46-106a2716073e

	/// Count of facilities with extreme severity % above the selected median.
	measure 'Facilities Above Median Extreme' = ```
			
			SUMX(
			    VALUES( Dim_Facility[Facility_Key] ),
			    [Is Above Median Extreme]
			)
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: 2f7a2178-e0e7-489c-99e9-5ab33dda803d

	/// Count of facilities in current filter context.
	measure 'Facilities Selected' = ```
			
			COUNTROWS( VALUES( Dim_Facility[Facility_Key] ) )
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: a70c49dd-9f5f-406e-83b6-5485b95badd4

	/// Name of facility with highest extreme severity share.
	measure 'Top Facility Extreme (Name)' = ```
			
			VAR T =
			    TOPN(
			        1,
			        VALUES( Dim_Facility[Facility_Name] ),
			        [Extreme Severity %],
			        DESC
			    )
			RETURN
			MAXX( T, Dim_Facility[Facility_Name] )
			
			```
		displayFolder: Helper
		lineageTag: 53d1a359-32b9-4db9-be91-cc21a257f561

	/// Extreme severity % of the facility with highest extreme share.
	measure 'Top Facility Extreme (%)' = ```
			
			VAR T =
			    TOPN(
			        1,
			        VALUES( Dim_Facility[Facility_Name] ),
			        [Extreme Severity %],
			        DESC
			    )
			RETURN
			MAXX( T, [Extreme Severity %] )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Helper
		lineageTag: f15d59d1-e9d8-4767-8473-e0bff83c176d

	/// Minimum SMI across facilities in selection.
	measure 'SMI Min' = ```
			
			MINX( VALUES( Dim_Facility[Facility_Key] ), [Severity Mix Index] )
			
			```
		displayFolder: Helper
		lineageTag: af9c713a-52d1-4d45-9d7b-ffbb90bf6e08

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Maximum SMI across facilities in selection.
	measure 'SMI Max' = ```
			
			MAXX( VALUES( Dim_Facility[Facility_Key] ), [Severity Mix Index] )
			
			```
		displayFolder: Helper
		lineageTag: 2ae0d58d-45ac-4f9b-ab09-4c3ca00b6016

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Concatenated list of peer groups in current selection.
	measure PeerGroups_Selected = ```
			
			    CONCATENATEX(
			        VALUES( Dim_PeerGroup[PeerGroup_Name] ),
			        Dim_PeerGroup[PeerGroup_Name],
			        ", "
			    )
			```
		displayFolder: Helper
		lineageTag: f8deb001-8bb8-42b9-8aca-289613ec05c2

	/// Count of facilities in current selection.
	measure 'Facility Count' = ```
			
			COUNTROWS (
			    VALUES ( Dim_Facility[Facility_Key] )
			)
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: 16ed3103-2ae5-4f16-91b7-e9323195d7b7

	/// Alias for PeerGroup Severity Median (FacilitySafe).
	measure 'SMI Peer Median' = ```
			[PeerGroup Severity Median (FacilitySafe)]
			
			```
		displayFolder: Helper
		lineageTag: 67bb807e-34b7-4d54-8aea-dfbdfa50a6da

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Count of facilities with SMI above peer group median.
	measure 'Facilities Above SMI Median' = ```
			
			VAR PeerMedian = [PeerGroup Severity Median (FacilitySafe)]
			RETURN
			COUNTROWS (
			    FILTER (
			        VALUES ( Dim_Facility[Facility_Key] ),
			        [Severity Mix Index] > PeerMedian
			    )
			)
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: 136cf811-d3c1-4c71-a585-9abc4745addc

	/// Count of facilities with SMI at or below peer group median.
	measure 'Facilities At or Below SMI Median' = ```
			
			VAR PeerMedian = [SMI Peer Median]
			RETURN
			COUNTROWS (
			    FILTER (
			        VALUES ( Dim_Facility[Facility_Key] ),
			        [Severity Mix Index] <= PeerMedian
			    )
			)
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: 95a3bf77-ad7b-41ce-bd60-46e57bed465d

	/// Flag (1/0) if facility SMI exceeds peer group median.
	measure 'Is Above PG Severity Median' = ```
			
			VAR smi = [Severity Mix Index]
			VAR med = [PeerGroup Severity Median]
			RETURN IF(NOT ISBLANK(smi) && smi > med, 1, 0)
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: bb74ddad-1a4f-465d-b8e7-8068d57df297

	/// Flag (1/0) if facility SMI exceeds its own peer group median. Uses peer-group-safe lookup. Returns blank if multiple facilities in context.
	measure 'Is Above Own PG Sev Median' = ```
			
			IF(
			    NOT HASONEVALUE(Dim_Facility[Facility_Key]),
			    BLANK(),
			    VAR smi = [Severity Mix Index]
			    VAR med = [PeerGroup Severity Median (FacilitySafe)]
			    RETURN IF(NOT ISBLANK(smi) && smi > med, 1, 0)
			)
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: b348ad4e-8958-4727-8c84-d914774a926a

	/// Count of facilities with SMI above their own peer group median.
	measure 'Facilities Above Own PG Sev Median' = ```
			
			-- Count of facilities above their OWN peer-group median
			SUMX(
			    VALUES( Dim_Facility[Facility_Key] ),
			    [Is Above Own PG Sev Median]
			)
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: 83b72a5e-669d-47b9-aceb-5d132867ff2a

	/// Median SMI across all facilities in current slicer selection. Ignores visual-level facility/peer group filters but respects slicer selections.
	measure 'SMI Median (All Facilities, Selected)' = ```
			
			VAR SelectedPeerGroups =
			    CALCULATETABLE(
			        VALUES( Dim_Facility[PeerGroup_Name] ),
			        ALLSELECTED( Dim_Facility[PeerGroup_Name] )
			    )
			VAR FacilitiesInScope =
			    CALCULATETABLE(
			        VALUES( Dim_Facility[Facility_Key] ),
			        ALLSELECTED( Dim_Facility[Facility_Key] ),
			        -- remove the visual’s hierarchy grain (PG + Facility) so median is "global"
			        REMOVEFILTERS( Dim_Facility[PeerGroup_Name] ),
			        REMOVEFILTERS( Dim_Facility[Facility_Key], Dim_Facility[Facility_Name] ),
			        -- re-apply peer-group slicer selection (so median changes if you slice PGs)
			        KEEPFILTERS( SelectedPeerGroups )
			    )
			RETURN
			MEDIANX(
			    FacilitiesInScope,
			    CALCULATE( [Severity Mix Index] )
			)
			
			```
		formatString: 0.00
		displayFolder: Helper
		lineageTag: b7aa5a3a-bbab-4e66-9372-9c899477e55d

	/// Flag (1/0) if facility SMI exceeds all-facilities median. Returns 0 if multiple facilities in context.
	measure 'Is Above SMI Median (All Facilities)' = ```
			
			VAR smi = [Severity Mix Index]
			VAR med = [SMI Median (All Facilities, Selected)]
			RETURN
			IF(
			    HASONEVALUE( Dim_Facility[Facility_Key] )
			        && NOT ISBLANK(smi)
			        && smi > med,
			    1,
			    0
			)
			
			```
		formatString: 0
		lineageTag: 1e19f9cf-a192-42ab-a61b-c49507e1811e

	/// Flag (1/0) if facility SMI exceeds peer group median. Uses facility-safe median calculation.
	measure 'Is Above PG Severity Median (facility safe)' =
			
			VAR smi = [Severity Mix Index]
			VAR med = [PeerGroup Severity Median (FacilitySafe)]
			RETURN IF(NOT ISBLANK(smi) && smi > med, 1, 0)
		formatString: 0
		displayFolder: Helper
		lineageTag: 2de1163a-3b85-4a8a-90da-b6bbe3ed9916

	/// Display text: SMI range as 'min – max' format. Returns blank if either value missing.
	measure 'SMI Range' =
			VAR _Min = [SMI Min]
			VAR _Max = [SMI Max]
			RETURN
			    IF(
			        NOT ISBLANK(_Min) && NOT ISBLANK(_Max),
			        FORMAT(_Min, "0.00") & " – " & FORMAT(_Max, "0.00"),
			        BLANK()
			    )
		displayFolder: Helper
		lineageTag: 164a91a2-5637-4a23-8966-571f35ed848a

	/// Median SMI across facilities in selected peer group. Requires peer group in filter context.
	measure 'PeerGroup Severity Median' = ```
			
			VAR CurrentPeerGroup =
			    SELECTEDVALUE ( Dim_Facility[PeerGroup_Name] )
			RETURN
			CALCULATE (
			    MEDIANX (
			        VALUES ( Dim_Facility[Facility_Key] ),
			        [Severity Mix Index]
			    ),
			    ALL ( Dim_Facility ),
			    Dim_Facility[PeerGroup_Name] = CurrentPeerGroup
			)
			
			```
		formatString: 0.00
		displayFolder: PeerGroup Benchmarks
		lineageTag: 2121ce2a-c599-45b8-84f6-1d617cef2fdd

	/// Peer group SMI median that works per facility row. Removes facility filter to calculate median across peer group.
	measure 'PeerGroup Severity Median (FacilitySafe)' = ```
			
			VAR FacilitiesInSelectedPeerGroups =
			    CALCULATETABLE(
			        VALUES(Dim_Facility[Facility_Key]),
			        REMOVEFILTERS(Dim_Facility)
			    )
			RETURN
			MEDIANX(
			    FacilitiesInSelectedPeerGroups,
			    CALCULATE([Severity Mix Index], REMOVEFILTERS(Dim_Facility))
			)
			
			```
		formatString: 0.00
		displayFolder: PeerGroup Benchmarks
		lineageTag: f6f5818f-adc7-4b8b-8e18-3acf830a34bf

	column Column
		isHidden
		formatString: 0
		lineageTag: 014dd9ee-aa0a-40e8-b20e-cf41115403d3
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _Severity = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 3ab72c50885d4fbd9477cb305117e9d6

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

