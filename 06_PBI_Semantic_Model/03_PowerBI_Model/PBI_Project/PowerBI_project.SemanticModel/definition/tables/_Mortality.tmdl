table _Mortality
	lineageTag: 0045e4f3-140d-4eaa-9bd5-7abd99387dca

	/// Total count of deaths from Fact_KPI_Mortality
	measure 'Mortality Deaths' = SUM(Fact_KPI_Mortality[Death_Count])
		formatString: #,0
		lineageTag: d6ed49db-f69c-42eb-b6e5-64653e1d00a9

	/// Median Mortality Rate across facilities within the selected PeerGroup
	measure 'PeerGroup Mortality Rate Median' =
			VAR pg = SELECTEDVALUE(Dim_Facility[PeerGroup_Name])
			RETURN
			CALCULATE(
			    MEDIANX(
			        VALUES(Dim_Facility[Facility_Key]),
			        [Mortality Rate]
			    ),
			    REMOVEFILTERS(Dim_Facility[Facility_Key], Dim_Facility[Facility_Name]),
			    KEEPFILTERS(Dim_Facility[PeerGroup_Name] = pg)
			)
		formatString: 0.00%
		displayFolder: PeerGroup Benchmarks
		lineageTag: 80400c08-b766-42f1-ac28-f36b03fbf579

	/// Flag (1/0) indicating if facility mortality rate exceeds peer group median
	measure 'Is Above PG Mortality Median' =
			VAR r = [Mortality Rate]
			VAR m = [PeerGroup Mortality Rate Median]
			RETURN IF(NOT ISBLANK(r) && r > m, 1, 0)
		formatString: 0
		displayFolder: Helper
		lineageTag: a031a8e8-f54d-4a8d-baa6-dcd4d87cfba1

	/// Count of facilities with mortality rate above their peer group median
	measure 'Facilities Above Own PG Mortality Median' =
			SUMX(
			    VALUES(Dim_Facility[Facility_Key]),
			    [Is Above PG Mortality Median]
			)
		formatString: #,0
		displayFolder: Helper
		lineageTag: 8b068887-e4be-4684-9846-088200a6a660

	/// Count of distinct facilities in current filter context
	measure 'Mortality Facility Count' = COUNTROWS(VALUES(Dim_Facility[Facility_Key]))
		formatString: #,0
		displayFolder: Helper
		lineageTag: c51bea79-dee0-4be4-82cb-2c29a2e3187c

	/// Threshold for mortality rate used in scatter plot analysis
	measure 'Mortality Threshold (%)' = 0.03
		formatString: 0.00%
		displayFolder: Thresholds
		lineageTag: d5846fc2-67df-4c46-b1cd-5a7f6824b607

	/// Minimum encounter volume threshold for scatter plot analysis
	measure 'Mortality Volume Threshold (Encounters)' = 3000
		formatString: #,0
		displayFolder: Thresholds
		lineageTag: 328ef24c-cbc7-4b1d-ae7a-83278fe06681

	/// Display text showing range of PeerGroup Mortality Rate Medians (min to max)
	measure 'PG Mortality Median Range' =
			VAR MinMedian = MINX(VALUES(Dim_Facility[PeerGroup_Name]), [PeerGroup Mortality Rate Median])
			VAR MaxMedian = MAXX(VALUES(Dim_Facility[PeerGroup_Name]), [PeerGroup Mortality Rate Median])
			RETURN
			FORMAT(MinMedian, "0.0%") & " to " & FORMAT(MaxMedian, "0.0%")
		displayFolder: Helper
		lineageTag: b367485a-4bd4-4e87-9d8b-31978d48be89

	/// Display text showing count of facilities above PG mortality median vs total facilities
	measure 'PG Mortality Facilities Summary' =
			VAR AboveCount = [Facilities Above Own PG Mortality Median]
			VAR TotalCount = [Mortality Facility Count]
			RETURN
			FORMAT(AboveCount, "#,0") & " of " & FORMAT(TotalCount, "#,0")
		displayFolder: Helper
		lineageTag: c781f926-772f-455b-a77d-72e5dba851d5

	/// Highest PeerGroup mortality rate median with peer group name
	measure 'Highest PG Mortality Rate' =
			VAR MaxRate = MAXX(VALUES(Dim_Facility[PeerGroup_Name]), [PeerGroup Mortality Rate Median])
			VAR PGName = MAXX(FILTER(VALUES(Dim_Facility[PeerGroup_Name]), [PeerGroup Mortality Rate Median] = MaxRate), Dim_Facility[PeerGroup_Name])
			RETURN
			FORMAT(MaxRate, "0.00%") & " (" & PGName & ")"
		displayFolder: Helper
		lineageTag: fc376d70-8cd4-492b-b7b6-0592c6fd1071

	/// Share of encounters with Major or Extreme Risk of Mortality (high-acuity cases)
	measure 'Major-Extreme ROM Share' = ```
			VAR HighRisk = 
			    CALCULATE(
			        SUM(vw_Fact_KPI_SeverityMix_BySeverity[Encounter_Count]),
			        Dim_ClinicalClass[APR_Risk_Of_Mortality_Desc] IN {"Major", "Extreme"}
			    )
			VAR Total = SUM(vw_Fact_KPI_SeverityMix_BySeverity[Encounter_Count])
			RETURN
			DIVIDE(HighRisk, Total)
			```
		formatString: 0.0%
		displayFolder: ROM Mix
		lineageTag: 78d94f95-e3cd-4383-9c32-bbc35323ff97

	/// Median Mortality Rate across all facilities regardless of peer group
	measure 'Cross-PG Mortality Rate Median' =
			MEDIANX(
			    VALUES(Dim_Facility[Facility_Key]),
			    [Mortality Rate]
			)
		formatString: 0.00%
		displayFolder: PeerGroup Benchmarks
		lineageTag: 928f100e-d2d4-40ba-91ce-1ebf723023c2

	/// Flag (1/0) indicating if facility mortality rate exceeds cross peer group median
	measure 'Is Above Cross-PG Mortality Median' =
			VAR r = [Mortality Rate]
			VAR m = [Cross-PG Mortality Rate Median]
			RETURN IF(NOT ISBLANK(r) && r > m, 1, 0)
		formatString: 0
		displayFolder: Helper
		lineageTag: 0db06d0f-54e1-4c61-80c9-94dc30333fea

	/// Count of facilities with mortality rate above cross peer group median
	measure 'Facilities Above Cross-PG Mortality Median' =
			SUMX(
			    VALUES(Dim_Facility[Facility_Key]),
			    [Is Above Cross-PG Mortality Median]
			)
		formatString: #,0
		displayFolder: Helper
		lineageTag: 7c255d57-a05d-412f-b48c-3ed049c7b166

	/// Display text showing count of facilities above cross-PG mortality median vs total
	measure 'Cross-PG Mortality Facilities Summary' =
			VAR AboveCount = [Facilities Above Cross-PG Mortality Median]
			VAR TotalCount = [Mortality Facility Count]
			RETURN
			FORMAT(AboveCount, "#,0") & " of " & FORMAT(TotalCount, "#,0")
		displayFolder: Helper
		lineageTag: e6caab55-9425-4cef-8a72-c03f50b7366a

	/// Conditional formatting: White if above PG median, gray otherwise
	measure 'Mortality Label Color' =
			VAR r = [Mortality Rate]
			VAR m = [PeerGroup Mortality Rate Median]
			RETURN
			IF(NOT ISBLANK(r) && r > m, "#FFFFFF", "#808080")
		displayFolder: Helper
		lineageTag: 1a4bfe68-67df-4b2a-a915-0adc8e36d2ef

	/// Sort helper for Major+Extreme ROM percentage
	measure 'Major-Extreme ROM % (Sort)' =
			CALCULATE(
			    DIVIDE(
			        SUM(vw_Fact_KPI_SeverityMix_BySeverity[Encounter_Count]),
			        CALCULATE(
			            SUM(vw_Fact_KPI_SeverityMix_BySeverity[Encounter_Count]),
			            ALLSELECTED(Dim_ClinicalClass[APR_Risk_Of_Mortality_Desc])
			        )
			    ),
			    ALLSELECTED(Dim_ClinicalClass[APR_Risk_Of_Mortality_Desc]),
			    Dim_ClinicalClass[APR_Risk_Of_Mortality_Desc] IN {"Major", "Extreme"}
			)
		formatString: 0.0%
		displayFolder: Helper
		lineageTag: e8a3e094-f8ec-4999-935c-4bbc3cca5d76

	/// Sort helper: Major+Extreme ROM share, ignores legend filter
	measure 'High ROM Sort' = ```
			VAR _Total = SUM(vw_Fact_KPI_SeverityMix_BySeverity[Encounter_Count])
			VAR _HighRisk = 
			    CALCULATE(
			        SUM(vw_Fact_KPI_SeverityMix_BySeverity[Encounter_Count]),
			        Dim_ClinicalClass[APR_Risk_Of_Mortality_Desc] IN {"Major", "Extreme"},
			        ALL(Dim_ClinicalClass[APR_Risk_Of_Mortality_Desc])
			    )
			RETURN
			DIVIDE(_HighRisk, _Total)
			```
		formatString: 0.0%
		isHidden
		displayFolder: Helper
		lineageTag: 6b7e400c-41a0-417c-a7ac-51dc36f16c82

	column Column
		formatString: 0
		lineageTag: 013ddd82-004a-4a95-abb1-0a803d6ffff1
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _Mortality = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 2b6b9e7c5c3945c8809dbc3eedef8d19

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

