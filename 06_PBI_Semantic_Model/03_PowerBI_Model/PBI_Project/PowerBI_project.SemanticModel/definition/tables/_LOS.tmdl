table _LOS
	lineageTag: 874ec203-bb35-4c59-a6b4-737b1ac71b37

	measure 'LOS Threshold (Days)' = ```
			5
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: 0bdd391b-29c9-44e9-bd2d-d0ed0f9ffdce

	measure 'LOS Volume Threshold (Encounters)' = 3000
		formatString: 0
		displayFolder: Helper
		lineageTag: 56191e9e-399e-4b90-8eaf-6218633dc20f

	measure 'LOS Total Facilities' = ```
			DISTINCTCOUNT(Dim_Facility[Facility_Key])
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: a971f21e-4c76-4e13-b053-4f46a4b297b2

	measure 'LOS Min (FacilitySafe)' =
			
			MINX(
			    CALCULATETABLE(VALUES(Dim_Facility[Facility_Key]), REMOVEFILTERS(Dim_Facility[Facility_Name])),
			    [AVG LOS]
			)
		displayFolder: Helper
		lineageTag: 11ac9856-735c-4632-8360-65e36be82852

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LOS Max (FacilitySafe)' = ```
			
			MAXX(
			    CALCULATETABLE(VALUES(Dim_Facility[Facility_Key]), REMOVEFILTERS(Dim_Facility[Facility_Name])),
			    [AVG LOS]
			)
			
			```
		displayFolder: Helper
		lineageTag: 22910f21-65c0-4019-b236-de4d5ff0a2f3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LOS Peer Median' = ```
			
			-- Cross-facility LOS median (across all facilities in current selection)
			MEDIANX( VALUES(Dim_Facility[Facility_Key]), [AVG LOS] )
			
			```
		displayFolder: Helper
		lineageTag: 21a441e1-cf44-43fc-ae34-ca8afc0ee025

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Is Above PG LOS Median' = ```
			
			VAR v = [AVG LOS]
			VAR m = [PeerGroup LOS Median]
			RETURN IF( NOT ISBLANK(v) && v > m, 1, 0)
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: 9a612987-788e-4a8a-8791-f46d7776e591

	measure 'Is Above Own PG LOS Median' = ```
			
			VAR v = [AVG LOS]
			VAR m = [PeerGroup LOS Median (PeerGroup safe)]
			RETURN IF( NOT ISBLANK(v) && v > m, 1, 0)
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: 2cbb311e-8f00-4e6b-baf8-fac5c65ca5c4

	measure 'Is Above LOS Median' = ```
			
			VAR v = [AVG LOS]
			VAR m = [LOS Peer Median]
			RETURN IF( NOT ISBLANK(v) && v > m, 1, 0)
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: e91c97a4-19d2-413d-bde9-398f8a97e6a7

	measure 'Is Below LOS Threshold' = ```
			
			IF( NOT ISBLANK([AVG LOS]) && [AVG LOS] < [LOS Threshold (Days)], 1, 0)
			
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: e553c3cd-f12a-4ba2-b50f-ae0974a29b70

	measure 'Is Below LOS Volume Threshold' =
			
			VAR enc = [Total Encounters]
			RETURN IF( NOT ISBLANK(enc) && enc < [LOS Volume Threshold (Encounters)], 1, 0)
		formatString: 0
		displayFolder: Helper
		lineageTag: 005cb404-6886-4d4f-b743-205c02ff6bd3

	measure 'Is Above LOS Volume Threshold' =
			
			VAR enc = [Total Encounters]
			RETURN IF( NOT ISBLANK(enc) && enc >= [LOS Volume Threshold (Encounters)], 1, 0)
		formatString: 0
		displayFolder: Helper
		lineageTag: 7e4ea352-220a-4186-904c-8977bc2250f8

	measure 'Facilities In LOS Low-Pressure Zone' = ```
			
			COUNTROWS(
			    FILTER(
			        VALUES(Dim_Facility[Facility_Key]),
			        [Is Below LOS Threshold] = 1
			            && [Is Below LOS Volume Threshold] = 1
			    )
			)
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: 1541672e-21d4-493a-b997-8d11a9642ac1

	measure 'Facilities Out of LOS Low-Pressure Zone' = ```
			
			[LOS Total Facilities] - [Facilities In LOS Low-Pressure Zone]
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: f9f4f37e-05be-41bc-aaf9-e316a57affda

	measure 'Facilities Above Both LOS Thresholds' = ```
			
			COUNTROWS(
			    FILTER(
			        VALUES(Dim_Facility[Facility_Key]),
			        [AVG LOS] >= [LOS Threshold (Days)]
			            && [Total Encounters] >= [LOS Volume Threshold (Encounters)]
			    )
			)
			
			```
		formatString: 0
		displayFolder: Helper
		lineageTag: b8c1a11e-d430-4802-8ae9-4cdbc995f0be

	measure 'PG LOS Median Range Text' = ```
			
			VAR pgList = VALUES(Dim_Facility[PeerGroup_Name])
			VAR minMed =
			    MINX(pgList, CALCULATE([PeerGroup LOS Median (PeerGroup safe)]))
			VAR maxMed =
			    MAXX(pgList, CALCULATE([PeerGroup LOS Median (PeerGroup safe)]))
			RETURN
			FORMAT(minMed, "0.00") & " to " & FORMAT(maxMed, "0.00")
			
			```
		displayFolder: Helper
		lineageTag: cfb40435-71c9-4ef3-8808-773827458ca8

	measure 'Excess LOS Days' = ```
			
			[AVG LOS] - [PeerGroup LOS Median]
			
			```
		displayFolder: Helper
		lineageTag: 39a0ec76-172f-41e4-b9b0-f616ad1729ed

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Excess LOS Days (PeerGroup safe)' = ```
			
			[AVG LOS] - [PeerGroup LOS Median (PeerGroup safe)]
			
			```
		displayFolder: Helper
		lineageTag: f2240854-765f-49f5-8384-4539489493fe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Bed-Days' =
			
			[AVG LOS] * [Total Encounters]
		formatString: 0
		lineageTag: d86d3105-1693-4626-9711-4833372cf718

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Share of Bed-Days' =
			
			DIVIDE(
			    [Total Bed-Days],
			    CALCULATE([Total Bed-Days], REMOVEFILTERS(Dim_Facility))
			)
		lineageTag: 5343bce0-2bad-4235-9b02-3f226ca4a482

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cross–Peer-Group LOS Median' =
			
			MEDIANX(
			    CALCULATETABLE(
			        VALUES(Dim_Facility[Facility_Key]),
			        REMOVEFILTERS(Dim_Facility[Facility_Name])
			    ),
			    [AVG LOS]
			)
		displayFolder: Helper
		lineageTag: d6f42f52-5829-4d1a-8a86-c59fc07b3a54

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Facilities Above CPG LOS Median' =
			
			VAR m = [Cross–Peer-Group LOS Median]
			RETURN
			COUNTROWS(
			    FILTER(
			        VALUES(Dim_Facility[Facility_Key]),
			        NOT ISBLANK([AVG LOS]) && [AVG LOS] > m
			    )
			)
		formatString: 0
		displayFolder: Helper
		lineageTag: 8021d41f-47d7-4f8b-9942-bb4c1f401b99

	measure 'Facilities Above Own Peer-Group LOS Median' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(Dim_Facility[Facility_Key]),
			        VAR v = [AVG LOS]
			        VAR pgm = [PeerGroup LOS Median (FacilitySafe)]
			        RETURN NOT ISBLANK(v) && NOT ISBLANK(pgm) && v > pgm
			    )
			)
		formatString: 0
		displayFolder: Helper
		lineageTag: ed377f10-050a-48a4-9fe6-df222851bb98

	measure 'Median Excess LOS (Days)' =
			
			MEDIANX(
			    VALUES(Dim_Facility[Facility_Key]),
			    VAR v = [AVG LOS]
			    VAR pgm = [PeerGroup LOS Median (FacilitySafe)]
			    RETURN IF(NOT ISBLANK(v) && NOT ISBLANK(pgm), v - pgm)
			)
		displayFolder: Helper
		lineageTag: 2e608c3e-32c3-4c18-8afc-17c267045b88

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Facilities Driving 50% of Bed-Days (Count)' =
			
			VAR Base =
			    ADDCOLUMNS(
			        VALUES(Dim_Facility[Facility_Key]),
			        "BedDays", [Total Bed-Days]
			    )
			VAR T =
			    FILTER(Base, NOT ISBLANK([Total Bed-Days]) && [BedDays] > 0)
			VAR Ranked =
			    ADDCOLUMNS(
			        T,
			        "RankBD", RANKX(T, [Total Bed-Days], , DESC, Dense)
			    )
			VAR TotalBD =
			    SUMX(Ranked, [Total Bed-Days])
			VAR WithCum =
			    ADDCOLUMNS(
			        Ranked,
			        "CumBD",
			            VAR r = [RankBD]
			            RETURN SUMX(FILTER(Ranked, [RankBD] <= r), [Total Bed-Days]),
			        "CumShare",
			            DIVIDE(
			                VAR r2 = [RankBD]
			                VAR cum2 = SUMX(FILTER(Ranked, [RankBD] <= r2), [Total Bed-Days])
			                RETURN cum2,
			                TotalBD
			            )
			    )
			VAR CutRank =
			    MINX(FILTER(WithCum, [CumShare] >= 0.5), [RankBD])
			RETURN
			CutRank
		formatString: 0
		lineageTag: caf85b95-9498-43dc-8fbe-48af96a42f82

