	measure 'Facilities Above Own Peer-Group LOS Median' = ```
			
			VAR Facilities =
			    VALUES(Dim_Facility[Facility_Key])
			VAR Result =
			    SUMX(
			        Facilities,
			        VAR v   = CALCULATE([AVG LOS])
			        VAR pgm = CALCULATE([PeerGroup LOS Median (PeerGroup safe)])
			        RETURN
			            IF(
			                NOT ISBLANK(v) && NOT ISBLANK(pgm) && v > pgm,
			                1,
			                0
			            )
			    )
			RETURN
			COALESCE(Result, 0)
			
			
			
			
			
