	measure 'Facility Bed-Days Share %' = ```
			
			VAR ThisBD = [Total Bed-Days]
			VAR TotalBD =
			    CALCULATE(
			        [Total Bed-Days],
			        ALLSELECTED(Dim_Facility[Facility_Key])
			    )
			RETURN
			DIVIDE(ThisBD, TotalBD)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e31044f0-9196-4770-829e-bfe46285edca

	measure 'Facility Bed-Days Rank' = ```
			
			VAR CurrentKey = SELECTEDVALUE(Dim_Facility[Facility_Key])
			VAR Facilities =
			    ADDCOLUMNS(
			        ALLSELECTED(Dim_Facility[Facility_Key]),
			        "@BD", CALCULATE([Total Bed-Days])
			    )
			VAR Ranked =
			    ADDCOLUMNS(
			        Facilities,
			        "@Rank", RANKX(Facilities, [@BD], , DESC, Dense)
			    )
			RETURN
			MAXX(
			    FILTER(Ranked, Dim_Facility[Facility_Key] = CurrentKey),
			    [@Rank]
			)
			
			```
		formatString: 0
		lineageTag: e738bbd7-f838-4fc0-9b00-b4ab7bceaf61

	measure 'Cumulative Bed-Days Share %' = ```
			
			VAR CurrentKey =
			    SELECTEDVALUE(Dim_Facility[Facility_Key])
			VAR Facilities =
			    ADDCOLUMNS(
			        ALLSELECTED(Dim_Facility[Facility_Key]),
			        "@BD", CALCULATE([Total Bed-Days])
			    )
			VAR TotalBD =
			    SUMX(Facilities, [@BD])
			VAR ThisBD =
			    CALCULATE([Total Bed-Days])
			VAR CumBD =
			    SUMX(
			        FILTER(
			            Facilities,
			            [@BD] > ThisBD
			                || ( [@BD] = ThisBD && Dim_Facility[Facility_Key] <= CurrentKey )
			        ),
			        [@BD]
			    )
			RETURN
			DIVIDE(CumBD, TotalBD)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b9131801-a5ba-4343-9aab-36d19f6d0977

