		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Facilities Driving 50% of Bed-Days (Count)' =
			
			VAR Base =
			    ADDCOLUMNS(
			        VALUES(Dim_Facility[Facility_Key]),
			        "BedDays", [Total Bed-Days]
			    )
			VAR T =
			    FILTER(Base, NOT ISBLANK([Total Bed-Days]) && [BedDays] > 0)
			VAR Ranked =
			    ADDCOLUMNS(
			        T,
			        "RankBD", RANKX(T, [Total Bed-Days], , DESC, Dense)
			    )
			VAR TotalBD =
			    SUMX(Ranked, [Total Bed-Days])
			VAR WithCum =
			    ADDCOLUMNS(
			        Ranked,
			        "CumBD",
			            VAR r = [RankBD]
			            RETURN SUMX(FILTER(Ranked, [RankBD] <= r), [Total Bed-Days]),
			        "CumShare",
			            DIVIDE(
			                VAR r2 = [RankBD]
			                VAR cum2 = SUMX(FILTER(Ranked, [RankBD] <= r2), [Total Bed-Days])
			                RETURN cum2,
			                TotalBD
			            )
			    )
			VAR CutRank =
			    MINX(FILTER(WithCum, [CumShare] >= 0.5), [RankBD])
			RETURN
			CutRank
		formatString: 0
		displayFolder: Helper
		lineageTag: caf85b95-9498-43dc-8fbe-48af96a42f82

	measure 'Excess LOS Color (WhatIf)' = ```
			
			VAR v = [Excess LOS Days]
			VAR t = SELECTEDVALUE('Excess LOS Materiality Threshold (Days)'[Excess LOS Materiality Threshold (Days)], 0.25)
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(v), "#D9D9D9",
			    v >= t,     "#B22222",
			    v > 0,      "#E9967A",
			    v <= -t,    "#2F5597",
			    v < 0,      "#9DC3E6",
			               "#9E9E9E"
			)
			
			```
		displayFolder: Helper
		lineageTag: 5387658b-e645-4fa7-ba5e-43a290516d9c

