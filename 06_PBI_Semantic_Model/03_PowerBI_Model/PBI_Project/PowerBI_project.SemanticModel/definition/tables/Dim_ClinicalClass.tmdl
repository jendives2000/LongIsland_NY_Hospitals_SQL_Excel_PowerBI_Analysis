	partition Dim_ClinicalClass = m
		mode: import
		source = ```
				let
				    Source = Sql.Database("DESKTOP-3O401KK", "LI_NYHealth", [HierarchicalNavigation=true]),
				    dbo = Source{[Schema="dbo"]}[Data],
				    Dim_ClinicalClass1 = dbo{[Name="Dim_ClinicalClass"]}[Data],
				    AddedROMSort = Table.AddColumn(Dim_ClinicalClass1, "APR_ROM_Sort", each 
				        if [APR_Risk_Of_Mortality_Desc] = "Minor" then 1
				        else if [APR_Risk_Of_Mortality_Desc] = "Moderate" then 2
				        else if [APR_Risk_Of_Mortality_Desc] = "Major" then 3
				        else if [APR_Risk_Of_Mortality_Desc] = "Extreme" then 4
				        else 999, Int64.Type)
				in
				    AddedROMSort
				```

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

