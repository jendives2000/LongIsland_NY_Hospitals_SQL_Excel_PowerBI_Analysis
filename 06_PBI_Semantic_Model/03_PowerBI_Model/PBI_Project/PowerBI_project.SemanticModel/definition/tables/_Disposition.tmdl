/// Disposition analysis measure container. Contains measures for discharge pattern analysis including home discharge share, post-acute care rates, transfer rates, in-hospital death rates, and peer group benchmarking for disposition outcomes.
table _Disposition
	lineageTag: 9e3e0b45-93e8-449c-8ab4-b7106ff886a6

	/// Encounter count for selected disposition category.
	measure 'Disp Total Encounters' = SUM(Fact_KPI_Disposition[Disposition_Count])
		formatString: 0
		lineageTag: 5eba2b4e-434b-46b2-89bd-a1c96631fd4b

	/// Percentage of facility encounters in the selected disposition category.
	measure 'Disposition Share' = ```
			
			DIVIDE(
			    [Disp Total Encounters],
			    CALCULATE(
			        [Disp Total Encounters],
			        ALL(Dim_Disposition)
			    )
			)
			
			```
		lineageTag: 8e872918-b161-408e-a526-397cfdfb8a00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total encounters for a facility-year across all disposition categories. Used as denominator for disposition share calculations.
	measure 'Disposition Facility-Year Encounters' =
			
			CALCULATE([Disp Total Encounters], ALL(Dim_Disposition))
		formatString: 0
		lineageTag: db0845f2-236d-4b49-b601-0eef2ed76b18

	/// Share of facility encounters discharged to home.
	measure 'Home Discharge Share %' =
			CALCULATE(
			    [Disposition Share],
			    Dim_Disposition[Disposition_Grouped] = "Home"
			)
		formatString: 0.0%
		displayFolder: Share Metrics
		lineageTag: 6dca9da3-22ee-4545-9091-90c7203e0ac9

	/// Share of facility encounters discharged to SNF or rehab facilities.
	measure 'Post-Acute Discharge Share %' =
			CALCULATE(
			    [Disposition Share],
			    Dim_Disposition[Disposition_Grouped] = "Skilled Nursing / Rehab"
			)
		formatString: 0.0%
		displayFolder: Share Metrics
		lineageTag: acf5b2a0-5f2d-4ca7-a309-929049b9832b

	/// Share of facility encounters in 'Other' disposition category. Includes acute transfers, AMA, hospice, and behavioral health discharges.
	measure 'Acute Transfer Share %' =
			CALCULATE(
			    [Disposition Share],
			    Dim_Disposition[Disposition_Grouped] = "Other"
			)
		formatString: 0.0%
		displayFolder: Share Metrics
		lineageTag: ec8d34e4-6c7f-4146-a27f-7d480fba02ae

	/// Share of facility encounters resulting in in-hospital death. Context: raw rate not risk-adjusted.
	measure 'In-Hospital Death Share %' =
			CALCULATE(
			    [Disposition Share],
			    Dim_Disposition[Disposition_Grouped] = "Death"
			)
		formatString: 0.0%
		displayFolder: Share Metrics
		lineageTag: cb92ddad-d835-4075-868c-ce46dc3abaa1

	/// Alias for Disposition Facility-Year Encounters.
	measure 'Total Inpatient Encounters' = [Disposition Facility-Year Encounters]
		formatString: #,##0
		displayFolder: Volume
		lineageTag: b4a41d74-5124-4395-87bd-942477dcc499

	/// Median post-acute discharge share across facilities in the selected peer group. Requires peer group in filter context.
	measure 'PeerGroup Post-Acute Share Median' = ```
			VAR CurrentPeerGroup = SELECTEDVALUE(Dim_PeerGroup[PeerGroup_Name])
			VAR FacilitiesInPeerGroup = 
			    CALCULATETABLE(
			        VALUES(Dim_Facility[Facility_Name]),
			        ALL(Dim_Facility),
			        Dim_PeerGroup[PeerGroup_Name] = CurrentPeerGroup
			    )
			RETURN
			MEDIANX(
			    FacilitiesInPeerGroup,
			    [Post-Acute Discharge Share %]
			)
			```
		formatString: 0.0%
		displayFolder: PeerGroup Benchmarks
		lineageTag: 9d8acee7-9788-44c4-a03e-ffa2855befee

	/// Flag (1/0) indicating if facility post-acute share exceeds peer group median
	measure 'Is Above PG Post-Acute Median' =
			IF(
			    [Post-Acute Discharge Share %] > [PeerGroup Post-Acute Share Median],
			    1,
			    0
			)
		formatString: 0
		isHidden
		displayFolder: Helper
		lineageTag: 34ef1ba6-c34b-4aa9-be56-49c84544afb4

	/// Count of facilities whose post-acute discharge share exceeds their own peer group median. Each facility compared to its assigned peer group.
	measure 'Facilities Above PG Post-Acute Median' =
			SUMX(
			    SUMMARIZE(
			        Bridge_Facility_PeerGroup,
			        Dim_PeerGroup[PeerGroup_Name],
			        Dim_Facility[Facility_Name]
			    ),
			    VAR FacilityRate = [Post-Acute Discharge Share %]
			    VAR PGMedian = [PeerGroup Post-Acute Share Median]
			    RETURN
			    IF(FacilityRate > PGMedian, 1, 0)
			)
		formatString: 0
		displayFolder: PeerGroup Benchmarks
		lineageTag: 69e7d6d8-19e4-479c-a45a-b2c79ce26cd3

	/// Alias for Acute Transfer Share %. Share of encounters in 'Other' disposition category.
	measure 'Other Discharge Share %' =
			CALCULATE(
			    [Disposition Share],
			    Dim_Disposition[Disposition_Grouped] = "Other"
			)
		formatString: 0.0%
		displayFolder: Share Metrics
		lineageTag: 5f25cb25-0ed4-46db-a5ab-00f0ae44ebe4

	/// Median acute transfer share across facilities in the selected peer group. Requires peer group in filter context.
	measure 'PeerGroup Acute Transfer Share Median' = ```
			VAR CurrentPeerGroup = SELECTEDVALUE(Dim_PeerGroup[PeerGroup_Name])
			VAR FacilitiesInPeerGroup = 
			    CALCULATETABLE(
			        VALUES(Dim_Facility[Facility_Name]),
			        ALL(Dim_Facility),
			        Dim_PeerGroup[PeerGroup_Name] = CurrentPeerGroup
			    )
			RETURN
			MEDIANX(
			    FacilitiesInPeerGroup,
			    [Acute Transfer Share %]
			)
			```
		formatString: 0.0%
		displayFolder: PeerGroup Benchmarks
		lineageTag: 2b150438-0773-43c1-93c1-828d584b4281

	/// Facility post-acute share minus peer group median, in percentage points. Positive = higher post-acute rate than peers. Returns blank if either value missing.
	measure 'Post-Acute vs Peer Median (pp)' =
			VAR FacilityRate = [Post-Acute Discharge Share %]
			VAR PGMedian = [PeerGroup Post-Acute Share Median]
			RETURN
			IF(
			    NOT ISBLANK(FacilityRate) && NOT ISBLANK(PGMedian),
			    (FacilityRate - PGMedian) * 100,
			    BLANK()
			)
		formatString: +0.0;-0.0;0.0
		displayFolder: Variance
		lineageTag: 0f14710d-2c3b-4260-808e-6451e6204111

	/// Facility acute transfer share minus peer group median, in percentage points. Positive = higher transfer rate than peers. Returns blank if either value missing.
	measure 'Transfer vs Peer Median (pp)' =
			VAR FacilityRate = [Acute Transfer Share %]
			VAR PGMedian = [PeerGroup Acute Transfer Share Median]
			RETURN
			IF(
			    NOT ISBLANK(FacilityRate) && NOT ISBLANK(PGMedian),
			    (FacilityRate - PGMedian) * 100,
			    BLANK()
			)
		formatString: +0.0;-0.0;0.0
		displayFolder: Variance
		lineageTag: 56dd824f-d96c-4345-9372-968d2fc0d6e5

	/// Conditional formatting: White if above PG median, gray otherwise
	measure 'Post-Acute Share Label Color' = ```
			VAR FacilityRate = [Post-Acute Discharge Share %]
			VAR CurrentPeerGroup = 
			    MAXX(
			        RELATEDTABLE(Bridge_Facility_PeerGroup),
			        RELATED(Dim_PeerGroup[PeerGroup_Name])
			    )
			VAR PGMedian = 
			    MEDIANX(
			        CALCULATETABLE(
			            VALUES(Dim_Facility[Facility_Name]),
			            ALL(Dim_Facility),
			            Dim_PeerGroup[PeerGroup_Name] = CurrentPeerGroup
			        ),
			        [Post-Acute Discharge Share %]
			    )
			RETURN
			IF(
			    ISBLANK(PGMedian),
			    "#808080",
			    IF(FacilityRate > PGMedian, "White", "#808080")
			)
			```
		isHidden
		displayFolder: Helper
		lineageTag: 6d9b36c5-1773-431a-9b9c-3df9e5771776

	/// Post-acute discharge median for the facility's peer group. Looks up peer group via bridge table when peer group is not in filter context. Use for per-facility comparisons in visuals without peer group on axis.
	measure 'Facility PeerGroup Post-Acute Median' = ```
			VAR CurrentPeerGroup = 
			    MAXX(
			        RELATEDTABLE(Bridge_Facility_PeerGroup),
			        RELATED(Dim_PeerGroup[PeerGroup_Name])
			    )
			RETURN
			MEDIANX(
			    CALCULATETABLE(
			        VALUES(Dim_Facility[Facility_Name]),
			        ALL(Dim_Facility),
			        Dim_PeerGroup[PeerGroup_Name] = CurrentPeerGroup
			    ),
			    [Post-Acute Discharge Share %]
			)
			```
		formatString: 0.0%
		displayFolder: PeerGroup Benchmarks
		lineageTag: 6360e029-50f1-413c-8a37-b88573ed1314

	/// Encounters discharged to 'Other' category (acute transfers, AMA, hospice, behavioral health).
	measure 'Acute Transfer Count' =
			CALCULATE(
			    [Disp Total Encounters],
			    Dim_Disposition[Disposition_Grouped] = "Other"
			)
		formatString: #,##0
		displayFolder: Volume
		lineageTag: c919271e-c92c-41fa-bf82-80be9af78af2

	/// Median in-hospital death share across all facilities system-wide. Ignores peer group assignment.
	measure 'Cross-PG Death Share Median' =
			MEDIANX(
			    VALUES(Dim_Facility[Facility_Name]),
			    [In-Hospital Death Share %]
			)
		formatString: 0.0%
		displayFolder: Cross-PG Benchmarks
		lineageTag: 930a3465-83b0-455b-b06b-ba94e4f0a54e

	/// Median acute transfer share across all facilities system-wide. Ignores peer group assignment.
	measure 'Cross-PG Acute Transfer Share Median' =
			MEDIANX(
			    VALUES(Dim_Facility[Facility_Name]),
			    [Acute Transfer Share %]
			)
		formatString: 0.0%
		displayFolder: Cross-PG Benchmarks
		lineageTag: c37464d5-9b70-402a-bc96-2d3cc864d64a

	column Column
		isHidden
		formatString: 0
		lineageTag: a3e94cdb-6a80-427c-9801-9a7487c175ce
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _Disposition = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 56e449eca94b4017834973e78460ec5a

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

